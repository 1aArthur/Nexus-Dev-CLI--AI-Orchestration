{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nexus.invalid/skill.schema.json",
  "title": "Nexus declarative Skill manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "engineRange",
    "runtime",
    "entryDocument",
    "permissions",
    "requiredTools",
    "providerCapabilities",
    "contentHashes",
    "license",
    "publisher",
    "signature"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "maxLength": 128
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 96 },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "engineRange": { "type": "string", "minLength": 1, "maxLength": 64 },
    "runtime": { "const": "declarative" },
    "entryDocument": { "const": "SKILL.md" },
    "permissions": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability"],
        "properties": {
          "capability": {
            "enum": [
              "artifact:read",
              "artifact:write",
              "catalog:read",
              "knowledge:read",
              "repository:read",
              "repository:write",
              "security:scan",
              "provider:invoke"
            ]
          },
          "scope": { "type": "string", "minLength": 1, "maxLength": 256 }
        }
      }
    },
    "requiredTools": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "providerCapabilities": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "enum": [
          "streaming",
          "tools",
          "vision",
          "structured_output",
          "realtime_voice"
        ]
      }
    },
    "contentHashes": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 256,
      "propertyNames": {
        "pattern": "^(SKILL\\.md|references/|templates/|schemas/)[A-Za-z0-9._/-]*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "license": { "type": "string", "minLength": 1, "maxLength": 128 },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "source"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 96 },
        "source": { "type": "string", "pattern": "^https://" }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId", "manifestSha256", "value"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "keyId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "manifestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "value": { "type": "string", "minLength": 32, "maxLength": 256 }
      }
    }
  }
}
