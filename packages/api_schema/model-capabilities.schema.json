{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nexus.invalid/model-capabilities.schema.json",
  "title": "Nexus exact-model capability record",
  "type": "object",
  "required": [
    "exactModelId",
    "provider",
    "reasoning",
    "supportsStreaming"
  ],
  "properties": {
    "exactModelId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "provider": {
      "enum": [
        "openai",
        "anthropic",
        "xai",
        "openai_compatible",
        "anthropic_compatible"
      ]
    },
    "supportsStreaming": { "type": "boolean" },
    "supportsVision": { "type": "boolean", "default": false },
    "supportsAudioInput": { "type": "boolean", "default": false },
    "supportsAudioOutput": { "type": "boolean", "default": false },
    "supportsToolCalls": { "type": "boolean", "default": false },
    "contextWindowTokens": { "type": "integer", "minimum": 1 },
    "maximumOutputTokens": { "type": "integer", "minimum": 1 },
    "reasoning": {
      "type": "object",
      "required": [
        "supportedUniversalLevels",
        "mappings",
        "unsupportedPolicy"
      ],
      "properties": {
        "supportedUniversalLevels": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["fast", "balanced", "deep", "max"] }
        },
        "mappings": {
          "type": "object",
          "propertyNames": { "enum": ["fast", "balanced", "deep", "max"] },
          "additionalProperties": {
            "type": "object",
            "required": ["providerParameters"],
            "properties": {
              "providerParameters": {
                "type": "object",
                "additionalProperties": {
                  "type": ["string", "number", "integer", "boolean", "null"]
                }
              }
            },
            "additionalProperties": false
          }
        },
        "unsupportedPolicy": { "enum": ["reject", "clamp", "omit"] }
      },
      "additionalProperties": false
    },
    "pricing": {
      "type": "object",
      "properties": {
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "inputMicrosPerMillionTokens": { "type": "integer", "minimum": 0 },
        "outputMicrosPerMillionTokens": { "type": "integer", "minimum": 0 },
        "effectiveFrom": { "type": "string", "format": "date-time" }
      },
      "required": [
        "currency",
        "inputMicrosPerMillionTokens",
        "outputMicrosPerMillionTokens",
        "effectiveFrom"
      ],
      "additionalProperties": false
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
