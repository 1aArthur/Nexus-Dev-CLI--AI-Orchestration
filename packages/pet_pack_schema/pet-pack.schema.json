{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nexus.invalid/pet-pack.schema.json",
  "title": "Nexus Pet Pack manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "license",
    "authorizedSource",
    "publisher",
    "signature",
    "spriteSheet",
    "animations"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "maxLength": 128
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 96 },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "license": { "type": "string", "minLength": 1, "maxLength": 128 },
    "authorizedSource": { "const": true },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "source"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 96 },
        "source": { "type": "string", "pattern": "^https://" }
      }
    },
    "signature": { "$ref": "#/$defs/signature" },
    "spriteSheet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "mimeType", "sha256", "width", "height", "frames"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^assets/[A-Za-z0-9._/-]+$",
          "maxLength": 256
        },
        "mimeType": { "enum": ["image/png", "image/webp"] },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "width": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "height": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "frames": { "type": "integer", "minimum": 1, "maximum": 2048 }
      }
    },
    "animations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["state", "startFrame", "frameCount", "fps", "loop"],
        "properties": {
          "state": {
            "enum": [
              "idle",
              "walk",
              "run",
              "work",
              "celebrate",
              "sleep",
              "wake",
              "error",
              "listen"
            ]
          },
          "startFrame": { "type": "integer", "minimum": 0, "maximum": 2047 },
          "frameCount": { "type": "integer", "minimum": 1, "maximum": 240 },
          "fps": { "type": "integer", "minimum": 1, "maximum": 30 },
          "loop": { "type": "boolean" }
        }
      }
    },
    "reducedMotionFrame": { "type": "integer", "minimum": 0, "maximum": 2047 }
  },
  "$defs": {
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId", "manifestSha256", "value"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "keyId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "manifestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "value": { "type": "string", "minLength": 32, "maxLength": 256 }
      }
    }
  }
}
